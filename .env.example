# Copy to .env in the repo root and fill in. Never commit .env.

# Google Maps Platform key with the "Map Tiles API" enabled.
# Restrict it to the Map Tiles API and set a daily quota in Cloud Console.
GOOGLE_TILES_API_KEY=

# Modal (https://modal.com/settings/tokens). The modal CLI reads these from
# the environment: `set -a; source .env; set +a`.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
